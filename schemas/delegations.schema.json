{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delegations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root", "grants"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "root": {"type": "string", "minLength": 1},
          "grants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._/-]*$"
            }
          }
        }
      }
    }
  }
}
