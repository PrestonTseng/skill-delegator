{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "type", "skills"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "type": {"enum": ["filesystem", "git"]},
          "resolved_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonical_id", "runtime_name", "path", "sha256"],
              "properties": {
                "canonical_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
                  "not": {"pattern": "[\u0000-\u001F\u007F]"}
                },
                "runtime_name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
                  "not": {"pattern": "[\u0000-\u001F\u007F]"}
                },
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        },
        "oneOf": [
          {
            "properties": {"type": {"const": "git"}},
            "required": ["resolved_commit", "tree_hash"]
          },
          {
            "properties": {"type": {"const": "filesystem"}},
            "required": ["tree_hash"],
            "not": {"required": ["resolved_commit"]}
          }
        ]
      }
    }
  }
}
