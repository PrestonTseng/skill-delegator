{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authority.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fail_closed", "fixture_policy"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "fail_closed": {"const": true},
        "fixture_policy": {"enum": ["none", "safe-main-example"]}
      }
    }
  }
}
