{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-delegator.local/schemas/exact-plan.schema.json",
  "title": "Skill Delegator exact reconciliation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_id", "target_scope", "config_inputs", "lock_sha256", "target_fingerprints", "operations", "blocked", "change_state"],
  "properties": {
    "schema_version": {"const": 1},
    "authority_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 128},
    "target_scope": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 128},
    "config_inputs": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/configInput"},
      "allOf": [
        {"contains": {"properties": {"name": {"const": "authority.yaml"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "pool.yaml"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "skill-lock.yaml"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "sources.yaml"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_fingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "sha256"],
        "properties": {
          "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 128},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"}
    },
    "blocked": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "change_state": {"enum": ["blocked", "changes", "converged"]}
  },
  "$defs": {
    "configInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "anyOf": [
            {"enum": ["authority.yaml", "delegations.yaml", "pool.yaml", "skill-lock.yaml", "sources.yaml"]},
            {"type": "string", "pattern": "^delegations/[a-z][a-z0-9-]*\\.yaml$"}
          ]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target_id", "path"],
      "properties": {
        "action": {"enum": ["CREATE", "REPLACE", "REMOVE", "KEEP", "PRESERVE_UNMANAGED"]},
        "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 128},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "entry_kind": {"enum": ["file", "directory", "symlink", "other"]},
        "current_source_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "desired_source_path": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
