{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "location", "skill_root"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "type": {"enum": ["filesystem", "git"]},
          "location": {"type": "string", "minLength": 1},
          "skill_root": {
            "description": "Confined snapshot-relative POSIX root; ordinary segments may be hidden (for example .claude/skills). Canonical skill suffixes remain relative to this root and non-hidden.",
            "type": "string",
            "minLength": 1
          },
          "track": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "git"}}},
            "then": {"required": ["track"]},
            "else": {"not": {"required": ["track"]}}
          }
        ]
      }
    }
  }
}
